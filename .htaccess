# ============================================================================
# Self Storages — .htaccess (Apache / LiteSpeed, π.χ. Hostinger)
# Αντιγράφεται αυτόματα στο dist/ από το build/dist.js.
# ============================================================================

ErrorDocument 404 /404.html

# --- Συμπίεση ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Caching στατικών αρχείων -----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# --- Security headers ---------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Επιτρέπει: τα δικά μας assets, τη φόρμα (Formspree), τον χάρτη (Google Maps
  # embed) και τα προαιρετικά analytics/pixels που φορτώνει το js/cookie-consent.js
  # ΜΟΝΟ μετά από συναίνεση (GA4/GTM, Clarity, Meta Pixel, LinkedIn Insight).
  # Αν δεν ενεργοποιήσετε ποτέ αυτά τα analytics, μπορείτε να αφαιρέσετε τα
  # αντίστοιχα domains παρακάτω για ακόμα πιο αυστηρό CSP.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://formspree.io; frame-src https://maps.google.com https://www.google.com; img-src 'self' data: https://www.facebook.com https://www.google-analytics.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://connect.facebook.net https://snap.licdn.com; connect-src 'self' https://formspree.io https://www.google-analytics.com https://www.clarity.ms"
</IfModule>

# --- HTTPS redirect (ενεργοποιήστε μετά την εγκατάσταση SSL) ---------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
